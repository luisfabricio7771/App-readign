{
  "name": "final-reader",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/prepare-pdf.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/prepare-assets.mjs",
    "desktop:runtime": "install-electron",
    "desktop:start": "npm run build && npm run desktop:runtime && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis portable --x64",
    "test:desktop-server": "node --test desktop/server.check.cjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Lector PDF local y privado con combates RPG y música opcional de YouTube.",
  "author": "Final Reader",
  "main": "desktop/main.cjs"
}
